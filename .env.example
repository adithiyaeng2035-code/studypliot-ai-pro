# Optional OpenAI-compatible chat completion provider. Required for AI doubt solving.
# Leave blank to keep only local task suggestions.
# OpenAI example: https://api.openai.com/v1 with model gpt-4o-mini.
# Set the secret in the process environment; do not store it in this file.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional: connect PostgreSQL instead of the default local SQLite database.
# Example: postgresql://studypilot:password@localhost:5432/studypilot
# DATABASE_URL=
# Alternatively set DATABASE_BACKEND=postgresql and configure PGHOST, PGPORT,
# PGDATABASE, PGUSER, and PGPASSWORD (libpq environment variables).

# Optional: override the default data/studypilot.sqlite3 database location.
# STUDYPILOT_DATABASE=
